# Copy to .env and fill in.

# Required. Signs admin sessions — use a long random string in production.
PAYLOAD_SECRET=

# Local development uses SQLite; production should use Postgres.
#   local:      file:./gefen.db
#   production: postgres://user:password@host/db
DATABASE_URI=file:./gefen.db

# Public origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only — uploads go to Vercel Blob when this is set.
# BLOB_READ_WRITE_TOKEN=

# Contact-form notifications. Without a key, enquiries are still stored and
# visible in the admin console; only the email is skipped.
# RESEND_API_KEY=
# RESEND_FROM="אור הכוכבים של גפן <contact@gefenstarlight.com>"
